# ===== Общие =====
# development | test | production
APP_ENV=development
# Минимум 32 символа. scripts/init_env.ps1 подставит случайное значение
SECRET_KEY=change-me-generate-with-scripts-init_env-ps1
API_PREFIX=/api/v1
# Через запятую, без пробелов внутри адресов
CORS_ORIGINS=http://localhost:8080

# ===== PostgreSQL =====
POSTGRES_USER=pcconf
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=pcconf
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Redis / Celery =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== Nginx =====
HTTP_PORT=8080

# ===== Импорт каталога docyx/pc-part-dataset =====
# Курс пересчёта цен датасета из USD в рубли. Такие цены помечаются «ориентировочная цена».
# Укажите актуальный курс перед импортом
DOCYX_USD_RUB_RATE=95
# Ветка или тег репозитория датасета
DOCYX_REF=main
